/* Stratum algorithm registry: one line per algorithm, expanded by stratum.cpp
 * into g_algos[] (keep the order, tests/vectors/hash.txt walks the table).
 *
 * ALGO(name, hash function, diff multiplier, merkle function, family, flags)
 *   family: STD (bitcoin-style stratum), PROGPOW, ETHASH, EQUIHASH, NEB
 *   flags:  0 or ALGO_NO_ROLLTIME (miners must not change ntime)
 */

ALGO("0x10", hash0x10, 1, 0, STD, 0)
