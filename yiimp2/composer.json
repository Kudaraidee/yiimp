{
    "require": {
        "php": ">=8.4",
        "yiisoft/yii2": "~2.0.53",
        "yiisoft/yii2-bootstrap5": "^2.0.4",
        "yiisoft/yii2-symfonymailer": "~2.0.4"
    },
    "require-dev": {
        "codeception/codeception": "^5.1",
        "codeception/lib-innerbrowser": "^4.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-yii2": "^1.1",
        "codeception/verify": "^3.2",
        "giorgiosironi/eris": "^1.0",
        "yiisoft/yii2-debug": "~2.1.25",
        "yiisoft/yii2-faker": "~2.0.5",
        "yiisoft/yii2-gii": "~2.2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\helpers\\": "tests/helpers/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
